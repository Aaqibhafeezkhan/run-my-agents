{
  "description": "Warn before editing a file another Claude session edited in the last 10 minutes",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check.mjs\"", "timeout": 5 }
        ]
      }
    ]
  }
}
